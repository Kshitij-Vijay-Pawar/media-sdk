{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@media/core": ["packages/media-core/src/index.ts"],
      "@media/react": ["packages/media-react/src/index.ts"],
      "@media/native": ["packages/media-native/src/index.ts"],
      "@media/ui-react": ["packages/media-ui-react/src/index.ts"],
      "@media/ui-native": ["packages/media-ui-native/src/index.ts"]
    },

    "strict": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true
  }
}